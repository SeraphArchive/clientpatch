<Page x:Class="ClientpatchManager.App.Views.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:ClientpatchManager.App.ViewModels"
      d:DataContext="{d:DesignInstance Type=vm:PluginsViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ScrollViewer.CanContentScroll="False"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer Padding="32,28" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ui:TextBlock Text="{Binding [plugTitle]}" FontTypography="Title" Margin="0,0,0,22" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="{Binding [plugScan]}"
                           Command="{Binding RescanCommand}" IsEnabled="{Binding BepinexEnabled}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Content="{Binding [plugOpen]}"
                           Command="{Binding OpenFolderCommand}" IsEnabled="{Binding BepinexEnabled}" />
            </StackPanel>

            <!-- bepinex off -->
            <ui:InfoBar Severity="Error" IsOpen="{Binding HasError}" IsClosable="False"
                        Title="{Binding [compBepin]}" Message="{Binding ErrorMessage}" Margin="0,0,0,14" />
            <ui:InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                        Title="{Binding [compBepin]}" Message="{Binding [plugNeedBepin]}"
                        Visibility="{Binding BepinexEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

            <!-- plugin list -->
            <ui:Card Visibility="{Binding BepinexEnabled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Enabled}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding [plugEmpty]}" Margin="0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
