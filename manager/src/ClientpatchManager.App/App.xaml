<Application x:Class="ClientpatchManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ClientpatchManager.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:StepStateToVisibilityConverter x:Key="StepStateToVisibility" />

            <!-- Shared by the Interop page and the handoff window. -->
            <DataTemplate x:Key="InteropStepTemplate">
                <ui:Card Padding="14,10" Margin="0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="18"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Visibility="{Binding State, Converter={StaticResource StepStateToVisibility}, ConverterParameter=Done}" />
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="18"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding State, Converter={StaticResource StepStateToVisibility}, ConverterParameter=Failed}" />
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
